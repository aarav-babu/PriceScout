# Copy this file to .env and adjust for your environment.
# python-dotenv loads these automatically when the app starts.

# --- Database (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=capstone

# --- Flask ---
# Generate a strong value for production, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=dev-insecure-change-me
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000

# --- Pricing engine ---
# When false (recommended for hosted demos), prices are estimated by training
# the model on the bundled market dataset instead of scraping live.
ENABLE_LIVE_SCRAPING=false
CACHED_CARS_DATASET=new_cars.csv
# Only relevant when ENABLE_LIVE_SCRAPING=true
SELENIUM_HEADLESS=true
