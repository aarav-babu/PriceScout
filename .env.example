# Copy this file to .env and adjust for your environment.
# python-dotenv loads these automatically when the app starts.

# --- Database (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=capstone

# --- Flask ---
# Generate a strong value for production, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=dev-insecure-change-me
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000

# --- Hosted pricing pipeline ---
# The web process enqueues work; Celery workers collect from authorized APIs,
# train versioned models, and persist estimates. Leave false on serverless
# deployments that do not have Redis and a worker.
PIPELINE_ENABLED=false
CACHED_CARS_DATASET=new_cars.csv
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# eBay Browse API: active asking-price comparables for all three categories.
# Production access and written approval for retention/model training may be
# required. The target currency must match the selected marketplace.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
TARGET_CURRENCY=USD
EBAY_RESULTS_PER_QUERY=50
PROVIDER_TIMEOUT_SECONDS=15

# Collection frequency adapts inside these bounds based on recent median-price
# changes. Values are minutes.
VEHICLE_MIN_REFRESH_MINUTES=240
VEHICLE_BASE_REFRESH_MINUTES=720
VEHICLE_MAX_REFRESH_MINUTES=1440
MOBILE_MIN_REFRESH_MINUTES=60
MOBILE_BASE_REFRESH_MINUTES=360
MOBILE_MAX_REFRESH_MINUTES=1440
LAPTOP_MIN_REFRESH_MINUTES=180
LAPTOP_BASE_REFRESH_MINUTES=720
LAPTOP_MAX_REFRESH_MINUTES=2880

MODEL_MINIMUM_ROWS=25
# Set this no higher than the provider agreement permits.
OBSERVATION_RETENTION_DAYS=7

# Writable directory for per-post CSV logs. Set to /tmp on serverless hosts
# (Vercel/Netlify) where the app filesystem is read-only.
# DATA_DIR=/tmp
